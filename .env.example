# Copy to .env (gitignored) and fill in. mise and docker compose both load .env automatically.

# OpenID Connect issuer URL (must match the `iss` claim in access tokens)
JWT_ISSUER_URI=https://auth.example.com
# API/resource identifier that tokens must be issued for (defaults to https://api.todos.local).
# The frontend requests access tokens for this resource too.
# JWT_AUDIENCE=https://api.todos.local

# --- Frontend sign-in (Logto "Traditional Web" app) ---
# Logto endpoint (JWT_ISSUER_URI without the trailing /oidc)
LOGTO_ENDPOINT=https://auth.example.com
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Encrypts the session cookie; at least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Public URL of the frontend; Logto redirects back to $APP_BASE_URL/callback (default http://localhost:3000)
# APP_BASE_URL=http://localhost:3000
# Where the frontend server reaches the backend (default http://localhost:8080)
# API_BASE_URL=http://localhost:8080

# --- E2E tests (Playwright) ---
# A Logto test user that signs in with username/identifier + password (no MFA or captcha)
E2E_USERNAME=
E2E_PASSWORD=
# App URL the tests open (default http://localhost:3000)
# E2E_BASE_URL=http://localhost:3000
