# Copy to .env (gitignored) and fill in from your identity provider's machine-to-machine app.

# Token endpoint (the issuer's `token_endpoint` from /.well-known/openid-configuration)
OIDC_TOKEN_URL=https://auth.example.com/token
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match the backend's JWT_AUDIENCE
OIDC_RESOURCE=https://api.todos.local
# A permission the M2M app's role grants on the API
OIDC_SCOPE=read:todos
